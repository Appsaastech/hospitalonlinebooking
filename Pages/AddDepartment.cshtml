@page
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Add Department";
}

<div class="container">

    <div class="card shadow p-4">

        <h2 class="mb-4">Add Department</h2>

        <form id="departmentForm">

            <div class="mb-3" id="divDepartmentName">
                <label class="form-label">
                    Department Name
                    <span class="text-danger">*</span>
                </label>

                <input type="text"
                       id="departmentName"
                       class="form-control"
                       placeholder="Enter department name" />
            </div>

            <div class="mb-3" id="divDescription">
                <label class="form-label">
                    Description
                </label>

                <textarea id="description"
                          class="form-control"
                          rows="4"
                          placeholder="Enter department description"></textarea>
            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Save Department
                </button>

                <a href="/DepartmentManagement"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>

        </form>

    </div>

</div>

<script>

    function SaveDepartment() {

        $(".lblvalidation").remove();

        var departmentName = $("#departmentName").val().trim();
        var description = $("#description").val().trim();

        if (departmentName == "") {

            $("#divDepartmentName").append(
                "<label class='text-danger lblvalidation'>Please enter Department Name</label>"
            );

            return;
        }

       

        $.ajax({

            type: "POST",

            url: "/DepartmentManagement/SaveDepartment",

            dataType: "json",

            contentType: "application/json",

            data: JSON.stringify({

                DepartmentName: departmentName,
                Description: description

            }),

            success: function (response) {

                 console.log(response);

                if (response.statuscode == 200 ||
                    response.statuscode == 201) {

                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: "Department Saved Successfully"
                    });

                    $("#departmentName").val("");
                    $("#description").val("");

                    setTimeout(function () {
                        window.location.href = "/DepartmentManagement";
                    }, 1000);
                }
                else {

                    Swal.fire({
                        icon: "error",
                        title: "Oops...",
                        text: response.responsedata
                    });
                }
            },

            error: function (xhr) {

            console.log(xhr);

            Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Something went wrong!"
            });
            }
        });
    }

    $(document).ready(function () {

        $("#departmentForm").submit(function (e) {

            e.preventDefault();

            SaveDepartment();

        });

    });

</script>