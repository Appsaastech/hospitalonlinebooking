@page

@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Schedule Listing";
}



    <div class="container">

        <!-- Heading + Button -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2 class="mb-1">Schedule Listing</h2>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Schedule Listing
                    </li>
                </ol>
            </nav>
        </div>

        <a href="/AddSchedule" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Schedule
        </a>
    </div>

        <!-- Table -->
        <table id="myTable" class="table table-bordered">

        <thead class="table-secondary">

                <tr>
                <th>Doctor Name</th>
                <th>Schedule Date</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Time Slots</th>
                </tr>

            </thead>

            <tbody></tbody>

        </table>

    </div>

<script>

    $(document).ready(function () {
        loadSchedules();
    });

    function loadSchedules() {

        $.ajax({
            type: "POST",
            url: "/ScheduleManagement/GetSchedules",
            dataType: "json",

            success: function (response) {

                let rows = "";

                $.each(response.responsedata, function (index, item) {

                    rows += `
                        <tr>
                            <td>${item.doctorName}</td>
                            <td>${item.scheduleDate}</td>
                            <td>${item.startTime}</td>
                            <td>${item.endTime}</td>
                            <td>${item.timeSlots}</td>
                        </tr>
                    `;
                });

                $("#myTable tbody").html(rows);

                if ($.fn.DataTable.isDataTable('#myTable')) {
                    $('#myTable').DataTable().destroy();
                }

                let table = new DataTable('#myTable');
            },

            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }

</script>

