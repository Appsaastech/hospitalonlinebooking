@page
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Department Management";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2 class="mb-1">Department Management</h2>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/">Home</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Department Management
                    </li>
                </ol>
            </nav>
        </div>

        <a href="/AddDepartment" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Department
        </a>
    </div>

    <table id="departmentTable" class="table table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>Department Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody></tbody>
    </table>

</div>

<!-- Edit Modal -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Edit Department</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="editDepartmentId" />

                <div class="mb-3">
                    <label class="form-label">Department Name</label>
                    <input type="text"
                           id="editDepartmentName"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea id="editDescription"
                              class="form-control"></textarea>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary"
                        onclick="updateDepartment()">
                    Update
                </button>
            </div>

        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        loadDepartments();
    });

    function loadDepartments() {

        $.ajax({
            type: "POST",
            url: "/DepartmentManagement/GetDepartments",
            dataType: "json",

            success: function (response) {

                if (response.statuscode == 401) {
                    alert("Authorization Failed");
                    return;
                }

                let rows = "";

                $.each(response.responsedata, function (index, item) {

                    rows += `
                        <tr>
                            <td>${item.departmentName}</td>
                            <td>${item.description}</td>
                            <td>

                                <button class="btn btn-warning btn-sm"
                                    onclick="editDepartment(${item.id})">
                                    Edit
                                </button>

                                <button class="btn btn-danger btn-sm"
                                    onclick="deleteDepartment(${item.id})">
                                    Delete
                                </button>

                            </td>
                        </tr>
                    `;
                });

                    if ($.fn.DataTable.isDataTable('#departmentTable')) {
        $('#departmentTable').DataTable().destroy();
    }

    $("#departmentTable tbody").html(rows);

    new DataTable('#departmentTable', {
        columnDefs: [
            {
                targets: 2,   // Actions column
                orderable: false
            }
        ]
    });
            },

            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }

    function editDepartment(id) {

        $.ajax({
            type: "POST",
            url: "/DepartmentManagement/GetDepartmentById",
            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({
                id: id
            }),

            success: function (response) {

                var dept = response.responsedata;

                $("#editDepartmentId").val(dept.id);
                $("#editDepartmentName").val(dept.departmentName);
                $("#editDescription").val(dept.description);

                var modal = new bootstrap.Modal(
                    document.getElementById("editDepartmentModal")
                );

                modal.show();
            },

            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }

    function updateDepartment() {

        let department = {

            id: parseInt($("#editDepartmentId").val()),
            departmentName: $("#editDepartmentName").val(),
            description: $("#editDescription").val()

        };

        $.ajax({
            type: "POST",
            url: "/DepartmentManagement/UpdateDepartment",
            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify(department),

            success: function (response) {

                if (response.statuscode == 200) {

                    alert("Department Updated Successfully");

                    loadDepartments();

                    bootstrap.Modal
                        .getInstance(document.getElementById("editDepartmentModal"))
                        .hide();
                }
                else {

                    alert(response.responsedata);
                }
            },

            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }

    function deleteDepartment(id) {

        if (!confirm("Delete this Department?"))
            return;

        $.ajax({
            type: "POST",
            url: "/DepartmentManagement/DeleteDepartment",
            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({
                id: id
            }),

            success: function (response) {

                if (response.statuscode == 200) {

                    alert("Department Deleted Successfully");

                    loadDepartments();
                }
                else {

                    alert(response.responsedata);
                }
            },

            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }

</script>