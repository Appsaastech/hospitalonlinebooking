@page

@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Schedule Listing";
}



    <div class="container">

        <!-- Heading + Button -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>Doctor Listing</h2>

            <a href="/AddSchedule" class="btn btn-primary">
                Add Schedule
            </a>

        </div>

        <!-- Table -->
        <table id="myTable" class="table table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Doctor Name</th>
                    <th>Date</th>
                    <th>Time</th>
                </tr>

            </thead>

            <tbody>

                <tr>
                    <td>Dr. Arun</td>
                    <td>06-05-2026</td>
                    <td>10:00 AM</td>
                </tr>

                <tr>
                    <td>Dr. Meera</td>
                    <td>06-05-2026</td>
                    <td>11:30 AM</td>
                </tr>

                <tr>
                    <td>Dr. Joseph</td>
                    <td>07-05-2026</td>
                    <td>02:00 PM</td>
                </tr>

                <tr>
                    <td>Dr. Anjali</td>
                    <td>08-05-2026</td>
                    <td>04:00 PM</td>
                </tr>

            </tbody>

        </table>

    </div>

    <script>

        let table = new DataTable('#myTable');

    </script>

