@page

@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Doctor Listing";
}




    <div class="container">

        <!-- Heading + Button -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>Doctor Management</h2>
        <div>
            <a href="/DepartmentManagement" class="btn btn-success">
                Department Management
            </a>

            <a href="/AddDoctor" class="btn btn-primary">
                Add Doctor
            </a>
        </div>

        </div>

        <!-- Doctor Table -->
        <table id="doctorTable" class="table table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Doctor Name</th>
                    <th>Description</th>
                    <th>Department</th>
                    <th>Qualification</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                <tr>
                    <td>Dr. Arun Kumar</td>
                    <td>Senior heart specialist</td>
                    <td>Cardiology</td>
                    <td>MBBS, MD</td>
                    <td>
                        <a href="/EditDoctor" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <button class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>Dr. Meera Nair</td>
                    <td>Neurology consultant</td>
                    <td>Neurology</td>
                    <td>MBBS, DM</td>
                    <td>
                        <a href="/EditDoctor" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <button class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>Dr. Joseph Mathew</td>
                    <td>Orthopedic surgeon</td>
                    <td>Orthopedics</td>
                    <td>MBBS, MS</td>
                    <td>
                        <a href="/EditDoctor" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <button class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>Dr. Anjali Menon</td>
                    <td>Pediatric specialist</td>
                    <td>Pediatrics</td>
                    <td>MBBS, DCH</td>
                    <td>
                        <a href="/EditDoctor" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <button class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

    <script>

        let table = new DataTable('#doctorTable', {
columnDefs: [
            {
                targets: 4,   // Actions column index (starts from 0)
                orderable: false
            }
        ]
    });

    </script>


