@page
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Patient Management";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-2">

        <div>
            <h2 class="mb-1">Patient Management</h2>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Patient Management
                    </li>
                </ol>
            </nav>
        </div>

        <a href="/AddPatient" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Patient
        </a>

    </div>

    <table id="patientTable" class="table table-bordered">

        <thead class="table-secondary">
            <tr>
                <th>Patient Registration No</th>
                <th>Patient Name</th>
                <th>Phone Number</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody></tbody>

    </table>

</div>

<!-- Edit Modal -->
<div class="modal fade" id="editPatientModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5>Edit Patient</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="editPatientId" />

                <div class="mb-3">
                    <label class="form-label">Patient Name</label>

                    <input type="text"
                           id="editPatientName"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number</label>

                    <input type="text"
                           id="editPhoneNumber"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Address</label>

                    <textarea id="editAddress"
                              class="form-control"></textarea>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        onclick="updatePatient()">
                    Update
                </button>

            </div>

        </div>

    </div>

</div>

<script>

    $(document).ready(function () {

        loadPatients();

    });

    function loadPatients() {

        $.ajax({

            type: "POST",
            url: "/PatientManagement/GetPatients",
            dataType: "json",

            success: function (response) {

                let rows = "";

                $.each(response.responsedata, function (index, item) {

                    rows += `
                        <tr>

                            <td>${item.patientRegistrationNo}</td>
                            <td>${item.patientName}</td>
                            <td>${item.phoneNumber}</td>
                            <td>${item.address}</td>

                            <td>

                                <button class="btn btn-warning btn-sm"
                                        onclick="editPatient(${item.id})">
                                    Edit
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        onclick="deletePatient(${item.id})">
                                    Delete
                                </button>

                            </td>

                        </tr>
                    `;
                });

                if ($.fn.DataTable.isDataTable('#patientTable')) {
                    $('#patientTable').DataTable().destroy();
                }

                $("#patientTable tbody").html(rows);

                new DataTable('#patientTable', {
                    columnDefs: [
                        {
                            targets: 4,
                            orderable: false
                        }
                    ]
                });
            },

            error: function (xhr) {

                alert(xhr.responseText);

            }
        });
    }

    function editPatient(id) {

        $.ajax({

            type: "POST",
            url: "/PatientManagement/GetPatientById",
            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({
                id: id
            }),

            success: function (response) {

                let patient = response.responsedata;

                $("#editPatientId").val(patient.id);
                $("#editPatientName").val(patient.patientName);
                $("#editPhoneNumber").val(patient.phoneNumber);
                $("#editAddress").val(patient.address);

                let modal = new bootstrap.Modal(
                    document.getElementById("editPatientModal")
                );

                modal.show();
            },

            error: function (xhr) {

                alert(xhr.responseText);

            }
        });
    }

    function updatePatient() {

        let patient = {

            id: parseInt($("#editPatientId").val()),
            patientName: $("#editPatientName").val(),
            phoneNumber: $("#editPhoneNumber").val(),
            address: $("#editAddress").val()

        };

        $.ajax({

            type: "POST",
            url: "/PatientManagement/UpdatePatient",
            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify(patient),

            success: function (response) {

                if (response.statuscode == 200) {

                    alert("Patient Updated Successfully");

                    loadPatients();

                    bootstrap.Modal
                        .getInstance(document.getElementById("editPatientModal"))
                        .hide();
                }
                else {

                    alert(response.responsedata);
                }
            },

            error: function (xhr) {

                alert(xhr.responseText);

            }
        });
    }

    function deletePatient(id) {

        if (!confirm("Delete this Patient?"))
            return;

        $.ajax({

            type: "POST",
            url: "/PatientManagement/DeletePatient",
            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({
                id: id
            }),

            success: function (response) {

                if (response.statuscode == 200) {

                    alert("Patient Deleted Successfully");

                    loadPatients();
                }
                else {

                    alert(response.responsedata);
                }
            },

            error: function (xhr) {

                alert(xhr.responseText);

            }
        });
    }

</script>