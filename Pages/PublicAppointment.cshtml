@page
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Public Appointment";
}

<div class="container-fluid p-4">

    <div class="card shadow w-100">
        <div class="card-header bg-primary text-white">
            <h3>Book Appointment</h3>
        </div>

        <div class="card-body">

            <!-- Patient Details -->
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5>Patient Details</h5>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Patient Registration Number</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="regNo" class="form-control"
                                   placeholder="Enter Registration Number">
                            <button type="button"
                                    id="btnSearchPatient"
                                    class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Department -->
            <div class="mb-3">
                <label class="form-label">Select Department</label>
                <select id="departmentSelect" class="form-select">
                    <option value="">-- Select Department --</option>
                </select>
            </div>

            <!-- Doctor -->
            <div class="mb-3" id="doctorSection" style="display:none;">
                <label class="form-label">Select Doctor</label>
                <select id="doctorSelect" class="form-select">
                    <option value="">-- Select Doctor --</option>
                </select>
            </div>

            <!-- Schedule -->
            <div id="scheduleSection" style="display:none;">
                <h4>Available Schedules (1 Week)</h4>

                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Available Slots</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="scheduleTableBody"></tbody>
                </table>
            </div>

        </div>
    </div>

</div>
<!-- Time Modal -->
<div class="modal fade" id="timeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5>Select Appointment Time</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label>Select Time Slot</label>
                <select id="timeSlotSelect" class="form-select">
                    <option value="">-- Select Time Slot --</option>
                </select>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary">Book Now</button>
            </div>

        </div>
    </div>
</div>
<!--patient modal-->
<div class="modal fade" id="patientModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Patient Details</h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <table class="table table-bordered">

                    <tr>
                        <th>Patient Name</th>
                        <td id="patientName"></td>
                    </tr>

                    <tr>
                        <th>Phone Number</th>
                        <td id="patientPhone"></td>
                    </tr>

                    <tr>
                        <th>Address</th>
                        <td id="patientAddress"></td>
                    </tr>

                </table>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

    $(document).ready(function () {

        loadDepartments();

    });

    // Search Patient

    $("#btnSearchPatient").click(function () {

        $.ajax({

            type: "POST",
            url: "/PublicAppointment/GetPatientByRegNo",

            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({

                patientRegistrationNo: $("#regNo").val()

            }),

               success: function (response) {

        console.log(response);

        if (response.statuscode == 200) {

            let patient = response.responsedata;

            $("#patientName").text(patient.patientName);
            $("#patientPhone").text(patient.phoneNumber);
            $("#patientAddress").text(patient.address);

            var modal = new bootstrap.Modal(
                document.getElementById("patientModal")
            );

            modal.show();
        }
        else {

            alert("Patient Not Found");

        }

    },

            error: function (xhr) {

                alert(xhr.responseText);

            }

        });

    });


    // Load Departments

    function loadDepartments() {

        $.ajax({

            type: "POST",
            url: "/PublicAppointment/GetDepartments",

            dataType: "json",

            success: function (response) {

                let options =
                    '<option value="">-- Select Department --</option>';

                $.each(response.responsedata, function (index, item) {

                    options += `
                        <option value="${item.id}">
                            ${item.departmentName}
                        </option>
                    `;

                });

                $("#departmentSelect").html(options);

            },

            error: function (xhr) {

                alert(xhr.responseText);

            }

        });

    }


    // Department Change

    $("#departmentSelect").change(function () {

        let departmentId = $(this).val();

        $("#scheduleSection").hide();

        if (departmentId == "") {

            $("#doctorSection").hide();
            return;

        }

        $.ajax({

            type: "POST",
            url: "/PublicAppointment/GetDoctorsByDepartment",

            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({

                departmentId: parseInt(departmentId)

            }),

            success: function (response) {

                let options =
                    '<option value="">-- Select Doctor --</option>';

                $.each(response.responsedata, function (index, item) {

                    options += `
                        <option value="${item.id}">
                            ${item.doctorName}
                        </option>
                    `;

                });

                $("#doctorSelect").html(options);

                $("#doctorSection").show();

            },

            error: function (xhr) {

                alert(xhr.responseText);

            }

        });

    });


    // Doctor Change

    $(document).on("change", "#doctorSelect", function () {

    var doctorId = $("#doctorSelect").val();

    console.log("DoctorId:", doctorId);

    if (!doctorId) {
        return;
    }

    $("#scheduleSection").hide();

        $.ajax({

            type: "POST",
            url: "/PublicAppointment/GetDoctorSchedules",

            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({

                doctorId: parseInt(doctorId)

            }),

                success: function (response) {

        let rows = "";

        $.each(response.responsedata, function (index, item) {

            rows += `
                <tr>
                    <td>${item.scheduleDate}</td>
                    <td>${item.day}</td>
                    <td>${item.availableSlots}</td>
                    <td>
                        <button
                            class="btn btn-primary btn-sm"
                            onclick="loadTimeSlots(${item.id})">
                            Choose
                        </button>
                    </td>
                </tr>
            `;
        });

        $("#scheduleTableBody").html(rows);
        $("#scheduleSection").show();
    },

            error: function (xhr) {

                alert(xhr.responseText);

            }

        });

    });


    // Load Time Slots

    function loadTimeSlots(scheduleId) {

        $.ajax({

            type: "POST",
            url: "/PublicAppointment/GetScheduleTimings",

            contentType: "application/json",
            dataType: "json",

            data: JSON.stringify({

                scheduleId: scheduleId

            }),

            success: function (response) {

                let options = "";

                $.each(response.responsedata, function (index, item) {

                    options += `
                        <option value="${item.timeSlot}">
                            ${item.timeSlot}
                        </option>
                    `;

                });

                $("#timeSlotSelect").html(options);

                var modal = new bootstrap.Modal(
                    document.getElementById("timeModal")
                );

                modal.show();

            },

            error: function (xhr) {

                alert(xhr.responseText);

            }

        });

    }

</script>