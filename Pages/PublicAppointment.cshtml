@page
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Public Appointment";
}

<div class="container-fluid p-4">

    <div class="card shadow w-100">
        <div class="card-header bg-primary text-white">
            <h3>Book Appointment</h3>
        </div>

        <div class="card-body">

            <!-- Patient Details -->
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5>Patient Details</h5>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Patient Registration Number</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="regNo" class="form-control"
                                   placeholder="Enter Registration Number">
                            <button class="btn btn-primary">Search</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Department -->
            <div class="mb-3">
                <label class="form-label">Select Department</label>
                <select id="departmentSelect" class="form-select">
                    <option value="">-- Select Department --</option>
                    <option value="general">General Dentistry</option>
                    <option value="orthodontics">Orthodontics</option>
                    <option value="endodontics">Endodontics</option>
                </select>
            </div>

            <!-- Doctor -->
            <div class="mb-3" id="doctorSection" style="display:none;">
                <label class="form-label">Select Doctor</label>
                <select id="doctorSelect" class="form-select"></select>
            </div>

            <!-- Schedule -->
            <div id="scheduleSection" style="display:none;">
                <h4>Available Schedules (1 Week)</h4>

                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Available Slots</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="scheduleTableBody"></tbody>
                </table>
            </div>

        </div>
    </div>

</div>
<!-- Time Modal -->
<div class="modal fade" id="timeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5>Select Appointment Time</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label>Select Time Slot</label>
                <select id="timeSlotSelect" class="form-select">
                    <option>09:00 AM</option>
                    <option>10:00 AM</option>
                    <option>11:00 AM</option>
                    <option>02:00 PM</option>
                    <option>03:00 PM</option>
                </select>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary">Book Now</button>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const doctors = {
        general: ["Dr. Anjali Nair", "Dr. Rahul Menon"],
        orthodontics: ["Dr. Meera Joseph", "Dr. Arjun Thomas"],
        endodontics: ["Dr. Neha Pillai", "Dr. Vivek Kumar"],
        periodontics: ["Dr. Sneha Mathew", "Dr. Rohan Das"],
        prosthodontics: ["Dr. Priya Varghese", "Dr. Akash George"],
        "oral-surgery": ["Dr. Sanjay Krishnan", "Dr. Deepak Nair"],
        pedodontics: ["Dr. Reshma Roy", "Dr. Anoop Mathew"],
        cosmetic: ["Dr. Divya Paul", "Dr. Kiran Babu"],
        implantology: ["Dr. Sreelakshmi", "Dr. Manu Raj"],
        "oral-medicine": ["Dr. Lakshmi Menon", "Dr. Harish Kumar"]
    };

    const departmentSelect = document.getElementById("departmentSelect");
    const doctorSelect = document.getElementById("doctorSelect");
    const doctorSection = document.getElementById("doctorSection");
    const scheduleSection = document.getElementById("scheduleSection");
    const scheduleTableBody = document.getElementById("scheduleTableBody");

    function registerPatient() {
        const name = document.getElementById("patientName").value;
        const phone = document.getElementById("phoneNumber").value;

        if (!name || !phone) {
            alert("Please enter patient name and phone number");
            return;
        }

        const generatedNumber = "PAT00001";

        document.getElementById("generatedRegNo").innerText = generatedNumber;
        document.getElementById("patientResult").style.display = "block";
    }

    departmentSelect.addEventListener("change", function () {
        const dept = this.value;

        doctorSelect.innerHTML = '<option value="">-- Select Doctor --</option>';
        scheduleSection.style.display = "none";

        if (dept) {
            doctorSection.style.display = "block";

            doctors[dept].forEach(doc => {
                doctorSelect.innerHTML += `<option>${doc}</option>`;
            });
        } else {
            doctorSection.style.display = "none";
        }
    });

    doctorSelect.addEventListener("change", function () {
        if (this.value) {
            loadSchedules();
        }
    });

    function loadSchedules() {
        scheduleSection.style.display = "block";
        scheduleTableBody.innerHTML = "";

        for (let i = 0; i < 7; i++) {
            let date = new Date();
            date.setDate(date.getDate() + i);

            scheduleTableBody.innerHTML += `
                <tr>
                    <td>${date.toLocaleDateString()}</td>
                    <td>${date.toLocaleDateString('en-US', { weekday: 'long' })}</td>
                    <td>5 Slots Available</td>
                    <td>
                        <button class="btn btn-primary btn-sm" onclick="openTimeModal()">
                            Choose
                        </button>
                    </td>
                </tr>
            `;
        }
    }

    function openTimeModal() {
        const modal = new bootstrap.Modal(document.getElementById('timeModal'));
        modal.show();
    }
</script>

